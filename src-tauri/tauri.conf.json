{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dreamland",
  "version": "0.1.1",
  "identifier": "icu.azusachino.dreamland",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dreamland",
        "width": 1100,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/dreamland/detail/**/*",
          "$HOME/.cache/dreamland/detail/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
